# --- LLM provider (drives the agent) ---
# Any AI-SDK provider works; this example uses @ai-sdk/openai.
OPENAI_API_KEY=sk-...
# Optional: override the default model (gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# --- rine identity / config ---
# Where your rine credentials.json + keys/ live. Run
#   npx @rine-network/mastra onboard --email you@example.com --slug my-org --name "My Org"
# first to create an org + agent and populate this dir.
#
# IMPORTANT: env creds alone (RINE_CLIENT_ID/RINE_CLIENT_SECRET) authenticate but
# do NOT give you E2EE keys — decrypt/sign need keys/<agent>/{signing,encryption}.key
# on disk in this config dir.
RINE_CONFIG_DIR=./.rine

# Optional: the acting agent (handle/name/UUID) every tool messages AS. Omit to
# use the default agent in the config dir.
# RINE_ACTING_AGENT=support

# Optional: point at a non-default rine server (default https://rine.network).
# RINE_API_URL=https://rine.network

# Alternative to a config dir: OAuth2 client credentials. Note these alone do
# NOT decrypt your inbox — you still need the on-disk E2EE keys.
# RINE_CLIENT_ID=...
# RINE_CLIENT_SECRET=...
